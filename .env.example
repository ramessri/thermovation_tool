# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change_me_in_production
CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://photogram:photogram@postgres:5432/photogram

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Storage ───────────────────────────────────────────────────────────────────
# Options: local | synology_webdav | synology_s3 | filestack
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage

# Synology WebDAV (enable WebDAV in DSM → Control Panel → File Services)
SYNOLOGY_WEBDAV_URL=http://192.168.1.50:5005/photogram
SYNOLOGY_USER=photogram_svc
SYNOLOGY_PASSWORD=

# Synology S3-compatible / MinIO
S3_ENDPOINT_URL=http://192.168.1.50:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=photogram

# Filestack
FILESTACK_API_KEY=

# ── ML Models ─────────────────────────────────────────────────────────────────
# Path where model weights are downloaded/cached
MODEL_CACHE_DIR=./models

# ── Pipeline ──────────────────────────────────────────────────────────────────
# Temp dir for in-progress job files (wiped after each task)
TEMP_DIR=/tmp/photogram
# Max frames to extract per video (reduce for faster dev iteration)
MAX_FRAMES_PER_VIDEO=500
# Target FPS for frame extraction (0 = extract all)
FRAME_EXTRACTION_FPS=2

# ── Ollama (optional local LLM) ──────────────────────────────────────────────
# Used for dimension extraction and scene description. Leave blank to disable.
# Docker compose overrides this with host.docker.internal — set here for native runs.
OLLAMA_URL=http://localhost:11434
OLLAMA_DIMENSION_MODEL=qwen2.5:7b
OLLAMA_GENERAL_MODEL=llama3.1:8b

# ── AI (optional) ─────────────────────────────────────────────────────────────
# Required only if using AI-assisted features (set in .env, not committed)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
